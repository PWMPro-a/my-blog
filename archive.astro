---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getArchiveGroups } from '../lib/blog';
import { formatDate } from '../lib/dates';
import { withBase } from '../lib/site';

const groups = await getArchiveGroups();
---
<BaseLayout title="归档" description="按年份查看全部文章。" pathname="/archive/">
  <section class="max-w-4xl">
    <p class="text-sm uppercase tracking-[0.2em] text-accent">Archive</p>
    <h1 class="mt-4 text-4xl font-semibold tracking-tight text-zinc-950 dark:text-white">归档</h1>
    <div class="mt-10 space-y-10">
      {groups.map((group) => (
        <section>
          <h2 class="text-2xl font-semibold text-zinc-900 dark:text-white">{group.year}</h2>
          <div class="mt-5 space-y-4 rounded-[1.5rem] border border-zinc-200/70 bg-white/75 p-6 dark:border-zinc-800 dark:bg-zinc-900/70">
            {group.items.map((post) => (
              <a href={withBase(`/posts/${post.slug}/`)} class="flex flex-col gap-1 rounded-2xl px-1 py-2 transition hover:text-accent md:flex-row md:items-center md:justify-between">
                <span class="font-medium text-zinc-900 dark:text-white">{post.data.title}</span>
                <time class="text-sm text-zinc-500 dark:text-zinc-400" datetime={post.data.pubDate.toISOString()}>{formatDate(post.data.pubDate)}</time>
              </a>
            ))}
          </div>
        </section>
      ))}
    </div>
  </section>
</BaseLayout>
