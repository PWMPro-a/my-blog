---
import type { TocItem } from '../lib/toc';

interface Props {
  items: TocItem[];
}

const { items } = Astro.props;
---
{items.length > 1 && (
  <aside class="rounded-3xl border border-zinc-200/70 bg-white/70 p-5 dark:border-zinc-800 dark:bg-zinc-900/70">
    <p class="text-sm font-semibold text-zinc-900 dark:text-white">文章目录</p>
    <ul class="mt-4 space-y-3 text-sm text-zinc-600 dark:text-zinc-300">
      {items.map((item) => (
        <li class={item.depth === 3 ? 'ml-4' : ''}>
          <a href={`#${item.slug}`} class="transition hover:text-accent">{item.text}</a>
        </li>
      ))}
    </ul>
  </aside>
)}
