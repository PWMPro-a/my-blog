---
import BaseLayout from '../../layouts/BaseLayout.astro';
import TagList from '../../components/TagList.astro';
import { getTagsWithCounts } from '../../lib/blog';

const tags = await getTagsWithCounts();
---
<BaseLayout title="标签" description="按标签查看文章。" pathname="/tags/">
  <section class="max-w-4xl">
    <p class="text-sm uppercase tracking-[0.2em] text-accent">Tags</p>
    <h1 class="mt-4 text-4xl font-semibold tracking-tight text-zinc-950 dark:text-white">标签</h1>
    <p class="mt-4 text-base leading-8 text-zinc-600 dark:text-zinc-300">按主题浏览内容，快速找到你关心的技术方向。</p>
    <div class="mt-8">
      <TagList tags={tags} />
    </div>
  </section>
</BaseLayout>
