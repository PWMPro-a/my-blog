---
import { formatDate } from '../lib/dates';
import { withBase } from '../lib/site';
import type { BlogEntry } from '../lib/blog';

interface Props {
  post: BlogEntry;
}

const { post } = Astro.props;
---
<article class="rounded-3xl border border-zinc-200/70 bg-white/80 p-6 shadow-card transition hover:-translate-y-1 dark:border-zinc-800 dark:bg-zinc-900/80">
  <div class="mb-4 flex flex-wrap items-center gap-3 text-sm text-zinc-500 dark:text-zinc-400">
    <time datetime={post.data.pubDate.toISOString()}>{formatDate(post.data.pubDate)}</time>
    <span>·</span>
    <span>{post.data.tags.join(' / ')}</span>
  </div>
  <h2 class="text-2xl font-semibold tracking-tight text-zinc-950 dark:text-white">
    <a href={withBase(`/posts/${post.slug}/`)} class="transition hover:text-accent">{post.data.title}</a>
  </h2>
  <p class="mt-3 text-sm leading-7 text-zinc-600 dark:text-zinc-300">{post.data.description}</p>
</article>
