---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="搜索" description="搜索 Lin Notes 的文章标题、描述、标签和摘要。" pathname="/search/">
  <section class="space-y-8">
    <div class="rounded-[2rem] border border-white/60 bg-white/72 p-6 shadow-glow backdrop-blur dark:border-slate-800/80 dark:bg-slate-950/72 md:p-10">
      <p class="font-mono text-[11px] uppercase tracking-[0.34em] text-accent">Search</p>
      <h1 class="mt-4 font-serif text-4xl tracking-[-0.04em] text-zinc-950 dark:text-white md:text-6xl">站内搜索</h1>
      <p class="mt-5 max-w-3xl text-base leading-8 text-zinc-600 dark:text-zinc-300">按文章标题、描述、标签和摘要做本地搜索，适合快速找回已经整理过的问题定位和工具链笔记。</p>
    </div>

    <div class="rounded-[1.75rem] border border-zinc-200/80 bg-white/72 p-5 shadow-panel dark:border-slate-800 dark:bg-slate-950/72 md:p-6">
      <form id="search-form" class="flex flex-col gap-3 md:flex-row">
        <label class="flex-1 text-sm text-zinc-600 dark:text-zinc-300">
          <span class="mb-2 block font-medium text-zinc-900 dark:text-white">关键词</span>
          <input id="search-input" name="q" type="search" autocomplete="off" class="w-full rounded-2xl border border-zinc-200 bg-white px-4 py-3 text-zinc-900 outline-none placeholder:text-zinc-400 focus:border-accent dark:border-slate-700 dark:bg-slate-950 dark:text-white" placeholder="例如 Turnstile、专题、工具链" />
        </label>
        <div class="flex items-end gap-3">
          <button type="submit" class="rounded-full bg-zinc-950 px-5 py-3 text-sm font-medium text-white hover:bg-accent dark:bg-white dark:text-zinc-950 dark:hover:bg-accent">搜索</button>
          <button type="button" id="search-clear" class="rounded-full border border-zinc-300/80 px-5 py-3 text-sm font-medium text-zinc-600 hover:border-accent hover:text-accent dark:border-slate-700 dark:text-zinc-300">清空</button>
        </div>
      </form>
    </div>

    <div id="search-status" class="text-sm text-zinc-500 dark:text-zinc-400">正在加载搜索索引…</div>
    <div id="search-results" class="space-y-4"></div>
  </section>

  <script is:inline>
    const input = document.getElementById('search-input');
    const form = document.getElementById('search-form');
    const clearButton = document.getElementById('search-clear');
    const status = document.getElementById('search-status');
    const results = document.getElementById('search-results');
    let items = [];

    const escapeHtml = (value) => String(value ?? '')
      .replace(/&/g, '&amp;')
      .replace(/</g, '&lt;')
      .replace(/>/g, '&gt;')
      .replace(/"/g, '&quot;')
      .replace(/'/g, '&#39;');

    const formatDate = (value) => {
      try {
        return new Intl.DateTimeFormat('zh-CN', { year: 'numeric', month: 'short', day: 'numeric' }).format(new Date(value));
      } catch {
        return value;
      }
    };

    const normalize = (value) => String(value ?? '').toLocaleLowerCase('zh-CN').trim();

    const renderResults = (query) => {
      const keyword = normalize(query);
      if (!keyword) {
        status.textContent = `已加载 ${items.length} 篇文章，输入关键词开始搜索。`;
        results.innerHTML = '';
        return;
      }

      const matched = items.filter((item) => [
        item.title,
        item.description,
        item.excerpt,
        item.slug,
        ...(Array.isArray(item.tags) ? item.tags : [])
      ].some((value) => normalize(value).includes(keyword)));

      status.textContent = matched.length ? `找到 ${matched.length} 篇相关文章。` : `没有找到与“${query}”匹配的文章。`;
      results.innerHTML = matched.length ? matched.map((item) => `
        <article class="rounded-[1.75rem] border border-zinc-200/80 bg-white/72 p-5 shadow-panel dark:border-slate-800 dark:bg-slate-950/72 md:p-6">
          <div class="flex flex-wrap items-center gap-3 text-xs uppercase tracking-[0.2em] text-zinc-500 dark:text-zinc-400">
            <time datetime="${escapeHtml(item.pubDate)}">${formatDate(item.pubDate)}</time>
            ${(Array.isArray(item.tags) ? item.tags : []).slice(0, 4).map((tag) => `<span class="rounded-full border border-zinc-200/80 px-2.5 py-1 text-[10px] tracking-[0.18em] dark:border-slate-700">#${escapeHtml(tag)}</span>`).join('')}
          </div>
          <h2 class="mt-4 text-2xl font-semibold tracking-[-0.03em] text-zinc-950 dark:text-white"><a href="${escapeHtml(item.url)}" class="hover:text-accent">${escapeHtml(item.title)}</a></h2>
          <p class="mt-3 text-sm leading-7 text-zinc-600 dark:text-zinc-300">${escapeHtml(item.description || item.excerpt)}</p>
          <a href="${escapeHtml(item.url)}" class="mt-5 inline-block text-sm font-medium text-zinc-700 hover:text-accent dark:text-zinc-200">继续阅读 →</a>
        </article>
      `).join('') : '<div class="rounded-[1.75rem] border border-dashed border-zinc-200/80 px-5 py-10 text-center text-sm leading-7 text-zinc-500 dark:border-slate-800 dark:text-zinc-400">换一个关键词试试，或从文章、标签、归档入口浏览。</div>';
    };

    const updateUrl = (query) => {
      const url = new URL(window.location.href);
      if (query) {
        url.searchParams.set('q', query);
      } else {
        url.searchParams.delete('q');
      }
      history.replaceState(null, '', url);
    };

    fetch('/search.json')
      .then((response) => response.json())
      .then((data) => {
        items = Array.isArray(data.items) ? data.items : [];
        const initialQuery = new URLSearchParams(window.location.search).get('q') || '';
        input.value = initialQuery;
        renderResults(initialQuery);
      })
      .catch(() => {
        status.textContent = '搜索索引加载失败，请稍后重试。';
      });

    form.addEventListener('submit', (event) => {
      event.preventDefault();
      const query = input.value.trim();
      updateUrl(query);
      renderResults(query);
    });

    input.addEventListener('input', () => {
      const query = input.value.trim();
      updateUrl(query);
      renderResults(query);
    });

    clearButton.addEventListener('click', () => {
      input.value = '';
      updateUrl('');
      renderResults('');
      input.focus();
    });
  </script>
</BaseLayout>
