---
import BaseLayout from '../layouts/BaseLayout.astro';
import PostCard from '../components/PostCard.astro';
import TagList from '../components/TagList.astro';
import { getFeaturedPosts, getRecentPosts, getTagsWithCounts, type BlogEntry } from '../lib/blog';
import { siteConfig, withBase } from '../lib/site';

const [featuredPosts, recentPosts, tags] = await Promise.all([
  getFeaturedPosts(),
  getRecentPosts(4),
  getTagsWithCounts()
]);

const leadFeaturedPost = featuredPosts[0];
const secondaryFeaturedPosts = featuredPosts.slice(1);
---
<BaseLayout>
  <section class="grid gap-8 rounded-[2rem] border border-white/60 bg-white/72 p-6 shadow-glow backdrop-blur md:p-10 xl:grid-cols-[minmax(0,1.35fr)_340px] dark:border-slate-800/80 dark:bg-slate-950/72">
    <div>
      <p class="font-mono text-[11px] uppercase tracking-[0.34em] text-accent">{siteConfig.brand.label}</p>
      <h1 class="mt-5 max-w-4xl font-serif text-5xl leading-[1.05] tracking-[-0.04em] text-zinc-950 dark:text-white md:text-7xl">{siteConfig.brand.heroTitle}</h1>
      <p class="mt-6 max-w-3xl text-base leading-8 text-zinc-600 dark:text-zinc-300 md:text-lg">{siteConfig.brand.heroSubtitle}</p>
      <div class="mt-8 flex flex-wrap gap-4">
        <a href={withBase('/posts')} class="rounded-full bg-zinc-950 px-5 py-3 text-sm font-medium text-white hover:bg-accent dark:bg-white dark:text-zinc-950">开始阅读</a>
        <a href={withBase('/about')} class="rounded-full border border-zinc-300/80 px-5 py-3 text-sm font-medium text-zinc-700 hover:border-accent hover:text-accent dark:border-slate-700 dark:text-zinc-200">关于我</a>
      </div>
      <div class="mt-10 grid gap-4 border-t border-zinc-200/80 pt-6 dark:border-slate-800/80 sm:grid-cols-3">
        {siteConfig.brand.principles.map((principle, index) => (
          <div class="rounded-[1.5rem] border border-zinc-200/80 bg-zinc-50/70 p-4 dark:border-slate-800 dark:bg-slate-900/55">
            <p class="font-mono text-[11px] uppercase tracking-[0.24em] text-zinc-500 dark:text-zinc-400">0{index + 1}</p>
            <p class="mt-3 text-sm leading-7 text-zinc-700 dark:text-zinc-200">{principle}</p>
          </div>
        ))}
      </div>
    </div>

    <aside class="flex flex-col justify-between rounded-[1.75rem] border border-zinc-200/80 bg-zinc-50/75 p-6 dark:border-slate-800 dark:bg-slate-900/60">
      <div>
        <p class="font-mono text-[11px] uppercase tracking-[0.28em] text-zinc-500 dark:text-zinc-400">Focus</p>
        <div class="mt-5 space-y-5">
          {siteConfig.brand.focusAreas.map((item) => (
            <div class="border-b border-zinc-200/80 pb-5 last:border-b-0 last:pb-0 dark:border-slate-800">
              <h2 class="text-base font-semibold text-zinc-950 dark:text-white">{item.title}</h2>
              <p class="mt-2 text-sm leading-7 text-zinc-600 dark:text-zinc-300">{item.description}</p>
            </div>
          ))}
        </div>
      </div>
      <div class="mt-8 rounded-[1.5rem] border border-zinc-200/80 bg-white/80 p-5 dark:border-slate-800 dark:bg-slate-950/80">
        <p class="text-xs uppercase tracking-[0.24em] text-zinc-500 dark:text-zinc-400">Author</p>
        <p class="mt-3 text-lg font-medium text-zinc-950 dark:text-white">{siteConfig.author}</p>
        <p class="mt-2 text-sm leading-7 text-zinc-600 dark:text-zinc-300">{siteConfig.brand.authorRole}</p>
      </div>
    </aside>
  </section>

  <section class="mt-16">
    <div class="mb-8 flex items-end justify-between gap-4">
      <div>
        <p class="font-mono text-[11px] uppercase tracking-[0.3em] text-accent">Selected Writing</p>
        <h2 class="mt-3 font-serif text-3xl tracking-[-0.03em] text-zinc-950 dark:text-white md:text-4xl">精选文章</h2>
      </div>
      <a href={withBase('/posts')} class="text-sm text-zinc-500 hover:text-accent dark:text-zinc-400">查看全部</a>
    </div>

    {leadFeaturedPost && (
      <div class="grid gap-6 xl:grid-cols-[minmax(0,1.3fr)_minmax(0,0.9fr)]">
        <PostCard post={leadFeaturedPost} variant="featured" />
        <div class="space-y-6">
          {secondaryFeaturedPosts.map((post: BlogEntry) => <PostCard post={post} />)}
        </div>
      </div>
    )}
  </section>

  <section class="mt-16 grid gap-8 xl:grid-cols-[minmax(0,1fr)_320px]">
    <div>
      <div class="mb-8">
        <p class="font-mono text-[11px] uppercase tracking-[0.3em] text-accent">Recent Notes</p>
        <h2 class="mt-3 font-serif text-3xl tracking-[-0.03em] text-zinc-950 dark:text-white md:text-4xl">最新文章</h2>
      </div>
      <div class="space-y-6">
        {recentPosts.map((post: BlogEntry) => <PostCard post={post} />)}
      </div>
    </div>

    <aside class="space-y-6">
      <section class="rounded-[1.75rem] border border-white/60 bg-white/72 p-6 shadow-panel backdrop-blur dark:border-slate-800/80 dark:bg-slate-950/72">
        <p class="font-mono text-[11px] uppercase tracking-[0.28em] text-zinc-500 dark:text-zinc-400">Explore by Topic</p>
        <h2 class="mt-3 text-xl font-semibold text-zinc-950 dark:text-white">主题入口</h2>
        <p class="mt-3 text-sm leading-7 text-zinc-600 dark:text-zinc-300">从工程、工具、自动化与前端实践切入，按主题快速进入内容脉络。</p>
        <div class="mt-6">
          <TagList tags={tags.slice(0, 10)} />
        </div>
      </section>

      <section class="rounded-[1.75rem] border border-zinc-200/80 bg-zinc-50/75 p-6 dark:border-slate-800 dark:bg-slate-900/60">
        <p class="font-mono text-[11px] uppercase tracking-[0.28em] text-zinc-500 dark:text-zinc-400">Closing Note</p>
        <p class="mt-4 font-serif text-2xl leading-tight text-zinc-950 dark:text-white">{siteConfig.brand.closingNote}</p>
        <a href={withBase('/about')} class="mt-6 inline-flex text-sm font-medium text-zinc-700 hover:text-accent dark:text-zinc-200">了解这个站点 →</a>
      </section>
    </aside>
  </section>
</BaseLayout>
