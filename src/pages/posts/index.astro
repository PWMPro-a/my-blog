---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostCard from '../../components/PostCard.astro';
import { getPublishedPosts } from '../../lib/blog';

const posts = await getPublishedPosts();
---
<BaseLayout title="文章" description="全部文章列表。" pathname="/posts/">
  <section>
    <div class="mb-10">
      <p class="text-sm uppercase tracking-[0.2em] text-accent">Posts</p>
      <h1 class="mt-4 text-4xl font-semibold tracking-tight text-zinc-950 dark:text-white">全部文章</h1>
      <p class="mt-4 max-w-2xl text-base leading-8 text-zinc-600 dark:text-zinc-300">按发布时间倒序整理，方便快速浏览最近的写作内容。</p>
    </div>
    <div class="space-y-6">
      {posts.map((post) => <PostCard post={post} />)}
    </div>
  </section>
</BaseLayout>
