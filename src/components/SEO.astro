---
import { siteConfig, withSiteAssetUrl, withSiteUrl } from '../lib/site';

interface Props {
  title?: string;
  description?: string;
  pathname?: string;
  image?: string;
  type?: 'website' | 'article';
  publishedTime?: string;
  updatedTime?: string;
  tags?: string[];
  author?: string;
}

const {
  title = siteConfig.title,
  description = siteConfig.description,
  pathname = '/',
  image,
  type = 'website',
  publishedTime,
  updatedTime,
  tags = [],
  author = siteConfig.author
} = Astro.props;

const canonical = withSiteUrl(pathname);
const pageTitle = title === siteConfig.title ? title : `${title} · ${siteConfig.title}`;
const ogImage = withSiteAssetUrl(image || siteConfig.defaultSocialImage);
---
<title>{pageTitle}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonical} />
<meta property="og:site_name" content={siteConfig.title} />
<meta property="og:locale" content={siteConfig.locale} />
<meta property="og:title" content={pageTitle} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta property="og:type" content={type} />
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={pageTitle} />
<meta name="twitter:description" content={description} />
<meta property="og:image" content={ogImage} />
<meta name="twitter:image" content={ogImage} />
{siteConfig.twitterSite && <meta name="twitter:site" content={siteConfig.twitterSite} />}
{type === 'article' && author && <meta property="article:author" content={author} />}
{type === 'article' && tags.map((tag) => <meta property="article:tag" content={tag} />)}
{publishedTime && <meta property="article:published_time" content={publishedTime} />}
{updatedTime && <meta property="article:modified_time" content={updatedTime} />}
