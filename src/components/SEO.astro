---
import { siteConfig, withSiteAssetUrl, withSiteUrl } from '../lib/site';

interface Props {
  title?: string;
  description?: string;
  pathname?: string;
  image?: string;
  type?: 'website' | 'article';
  publishedTime?: string;
  updatedTime?: string;
}

const {
  title = siteConfig.title,
  description = siteConfig.description,
  pathname = '/',
  image,
  type = 'website',
  publishedTime,
  updatedTime
} = Astro.props;

const canonical = withSiteUrl(pathname);
const pageTitle = title === siteConfig.title ? title : `${title} · ${siteConfig.title}`;
const ogImage = image ? withSiteAssetUrl(image) : undefined;
---
<title>{pageTitle}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonical} />
<meta property="og:site_name" content={siteConfig.title} />
<meta property="og:locale" content={siteConfig.locale} />
<meta property="og:title" content={pageTitle} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta property="og:type" content={type} />
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={pageTitle} />
<meta name="twitter:description" content={description} />
{ogImage && <meta property="og:image" content={ogImage} />}
{ogImage && <meta name="twitter:image" content={ogImage} />}
{publishedTime && <meta property="article:published_time" content={publishedTime} />}
{updatedTime && <meta property="article:modified_time" content={updatedTime} />}
