---
import { isCommentsConfigured, isTurnstileConfigured, siteConfig, withSiteUrl } from '../lib/site';

interface Props {
  slug: string;
  title: string;
}

const { slug, title } = Astro.props;
const commentsConfig = {
  enabled: siteConfig.comments.enabled,
  apiBaseUrl: siteConfig.comments.apiBaseUrl,
  turnstileSiteKey: siteConfig.comments.turnstileSiteKey,
  maxDepth: siteConfig.comments.maxDepth,
  slug,
  postTitle: title,
  postUrl: withSiteUrl(`/posts/${slug}/`),
  isTurnstileConfigured
};
const commentsConfigJson = JSON.stringify(commentsConfig);
---
<section class="mt-12 rounded-[2rem] border border-zinc-200/80 bg-white/72 p-6 shadow-panel dark:border-slate-800 dark:bg-slate-950/72 md:p-8">
  <div class="mb-6 border-b border-zinc-200/80 pb-5 dark:border-slate-800">
    <p class="font-mono text-[11px] uppercase tracking-[0.28em] text-zinc-500 dark:text-zinc-400">Discussion</p>
    <div class="mt-3 flex flex-wrap items-end justify-between gap-3">
      <div>
        <h2 class="text-2xl font-semibold tracking-[-0.02em] text-zinc-950 dark:text-white">评论区</h2>
        <p class="mt-2 text-sm leading-7 text-zinc-600 dark:text-zinc-300">游客可以直接评论，也可以回复已通过审核的留言。新评论默认进入审核队列。</p>
      </div>
      <p class="rounded-full border border-zinc-200/80 bg-white/70 px-3 py-1 text-[11px] uppercase tracking-[0.22em] text-zinc-500 dark:border-slate-700 dark:bg-slate-900/70 dark:text-zinc-400">
        审核制 · 最多 {siteConfig.comments.maxDepth + 1} 层
      </p>
    </div>
  </div>

  {isCommentsConfigured ? (
    <div id="comments-root" class="space-y-8"></div>
  ) : (
    <div class="space-y-3 text-sm leading-7 text-zinc-600 dark:text-zinc-300">
      <p class="font-medium text-zinc-900 dark:text-white">评论服务待配置</p>
      <p>请先在 <code>src/lib/site.ts</code> 中填写 comments API 地址与 Turnstile site key，然后重新构建站点。</p>
    </div>
  )}
</section>

{isCommentsConfigured && (
  <script is:inline define:vars={{ commentsConfigJson }}>
    const config = JSON.parse(commentsConfigJson);
    const root = document.getElementById('comments-root');

    if (root) {
      const state = {
        comments: [],
        loading: true,
        submitting: false,
        error: '',
        success: '',
        replyParentId: null,
        replyTargetName: '',
        turnstileWidgetId: null,
        turnstileReady: false
      };

      const escapeHtml = (value) => value
        .replace(/&/g, '&amp;')
        .replace(/</g, '&lt;')
        .replace(/>/g, '&gt;')
        .replace(/"/g, '&quot;')
        .replace(/'/g, '&#39;');

      const formatDate = (value) => {
        try {
          return new Intl.DateTimeFormat('zh-CN', {
            year: 'numeric',
            month: 'short',
            day: 'numeric',
            hour: '2-digit',
            minute: '2-digit'
          }).format(new Date(value));
        } catch {
          return value;
        }
      };

      const getTurnstileToken = () => {
        if (!config.isTurnstileConfigured) return '';
        if (!window.turnstile || !state.turnstileWidgetId) return '';
        return window.turnstile.getResponse(state.turnstileWidgetId) || '';
      };

      const resetTurnstile = () => {
        if (!config.isTurnstileConfigured) return;
        if (window.turnstile && state.turnstileWidgetId) {
          window.turnstile.reset(state.turnstileWidgetId);
        }
      };

      const getVisitorToken = () => {
        const key = 'lin-notes-comment-visitor';
        try {
          const stored = localStorage.getItem(key);
          if (stored && /^[a-zA-Z0-9_-]{16,128}$/.test(stored)) return stored;
          const bytes = new Uint8Array(24);
          crypto.getRandomValues(bytes);
          const token = Array.from(bytes, (byte) => byte.toString(16).padStart(2, '0')).join('');
          localStorage.setItem(key, token);
          return token;
        } catch {
          return '';
        }
      };

      const visitorHeaders = () => {
        const token = getVisitorToken();
        return token ? { 'x-comment-visitor': token } : {};
      };

      const updateCommentNode = (comments, commentId, values) => comments.map((comment) => {
        if (comment.id === commentId) return { ...comment, ...values };
        if (Array.isArray(comment.replies) && comment.replies.length) {
          return { ...comment, replies: updateCommentNode(comment.replies, commentId, values) };
        }
        return comment;
      });

      const replyButton = (comment) => {
        if (comment.depth >= config.maxDepth) return '';
        return `<button type="button" data-action="reply" data-comment-id="${comment.id}" data-author-name="${escapeHtml(comment.authorName)}" class="rounded-full border border-zinc-200/80 px-3 py-1 text-xs font-medium text-zinc-600 hover:border-accent hover:text-accent dark:border-slate-700 dark:text-zinc-300">回复</button>`;
      };

      const likeButton = (comment) => {
        const likeCount = Number(comment.likeCount || 0);
        const label = comment.likedByViewer ? '已赞' : '点赞';
        const activeClass = comment.likedByViewer ? 'border-accent bg-accent/10 text-accent' : 'border-zinc-200/80 text-zinc-600 hover:border-accent hover:text-accent dark:border-slate-700 dark:text-zinc-300';
        return `<button type="button" data-action="like" data-comment-id="${comment.id}" data-liked="${comment.likedByViewer ? 'true' : 'false'}" class="rounded-full border px-3 py-1 text-xs font-medium ${activeClass}">${label} · ${likeCount}</button>`;
      };

      const renderComment = (comment) => {
        const website = comment.authorWebsite ? `<a href="${comment.authorWebsite}" target="_blank" rel="noreferrer" class="hover:text-accent">${escapeHtml(comment.authorName)}</a>` : `<span>${escapeHtml(comment.authorName)}</span>`;
        const bloggerLikedBadge = comment.bloggerLiked ? '<span class="rounded-full border border-accent/30 bg-accent/10 px-2.5 py-1 text-[11px] font-medium text-accent">博主赞过</span>' : '';
        const replies = Array.isArray(comment.replies) && comment.replies.length
          ? `<div class="mt-4 space-y-4 border-l border-zinc-200/80 pl-4 dark:border-slate-800 md:pl-6">${comment.replies.map(renderComment).join('')}</div>`
          : '';

        return `
          <article class="rounded-[1.5rem] border border-zinc-200/80 bg-white/80 p-4 shadow-sm dark:border-slate-800 dark:bg-slate-900/70 md:p-5">
            <div class="flex flex-wrap items-center gap-x-3 gap-y-2 text-sm text-zinc-500 dark:text-zinc-400">
              <p class="font-medium text-zinc-900 dark:text-white">${website}</p>
              <span>·</span>
              <time datetime="${comment.createdAt}">${formatDate(comment.createdAt)}</time>
              ${bloggerLikedBadge}
              <span class="ml-auto">第 ${comment.depth + 1} 层</span>
            </div>
            <div class="mt-3 text-sm leading-7 text-zinc-700 dark:text-zinc-200">${comment.bodyHtml}</div>
            <div class="mt-4 flex flex-wrap items-center gap-2">${likeButton(comment)}${replyButton(comment)}</div>
            ${replies}
          </article>
        `;
      };

      const renderForm = () => {
        const replyHint = state.replyParentId
          ? `<div class="mb-4 flex items-center justify-between gap-3 rounded-2xl border border-accent/25 bg-accent/10 px-4 py-3 text-sm text-zinc-700 dark:text-zinc-200"><p>正在回复 <strong class="text-zinc-950 dark:text-white">${escapeHtml(state.replyTargetName)}</strong></p><button type="button" data-action="cancel-reply" class="text-xs font-medium uppercase tracking-[0.18em] text-accent">取消</button></div>`
          : '';
        const turnstileBlock = config.isTurnstileConfigured
          ? '<div id="comments-turnstile" class="min-h-[65px]"></div>'
          : '<div class="rounded-2xl border border-amber-300/60 bg-amber-50/90 px-4 py-3 text-sm leading-6 text-amber-900 dark:border-amber-500/30 dark:bg-amber-500/10 dark:text-amber-100">Turnstile site key 尚未配置。当前页面仍可展示评论，但不会允许真实提交。</div>';
        const feedback = state.error
          ? `<div class="rounded-2xl border border-rose-300/70 bg-rose-50/90 px-4 py-3 text-sm leading-6 text-rose-700 dark:border-rose-500/30 dark:bg-rose-500/10 dark:text-rose-100">${escapeHtml(state.error)}</div>`
          : state.success
            ? `<div class="rounded-2xl border border-emerald-300/70 bg-emerald-50/90 px-4 py-3 text-sm leading-6 text-emerald-700 dark:border-emerald-500/30 dark:bg-emerald-500/10 dark:text-emerald-100">${escapeHtml(state.success)}</div>`
            : '';

        return `
          <form id="comment-form" class="rounded-[1.75rem] border border-zinc-200/80 bg-zinc-50/80 p-5 dark:border-slate-800 dark:bg-slate-900/60 md:p-6">
            <div class="mb-5 flex items-center justify-between gap-3">
              <div>
                <h3 class="text-lg font-semibold text-zinc-950 dark:text-white">留下你的评论</h3>
                <p class="mt-1 text-sm text-zinc-600 dark:text-zinc-300">支持游客评论与楼中回复，提交后需要管理员审核。视频请粘贴 B 站、YouTube、Cloudflare Stream 或 R2 链接并单独放一行，不支持 HTML。</p>
              </div>
            </div>
            ${replyHint}
            <div class="grid gap-4 md:grid-cols-2">
              <label class="block text-sm text-zinc-600 dark:text-zinc-300">
                <span class="mb-2 block font-medium text-zinc-900 dark:text-white">昵称</span>
                <input name="authorName" maxlength="60" required class="w-full rounded-2xl border border-zinc-200 bg-white px-4 py-3 text-zinc-900 outline-none ring-0 placeholder:text-zinc-400 focus:border-accent dark:border-slate-700 dark:bg-slate-950 dark:text-white" placeholder="怎么称呼你？" />
              </label>
              <label class="block text-sm text-zinc-600 dark:text-zinc-300">
                <span class="mb-2 block font-medium text-zinc-900 dark:text-white">个人主页（可选）</span>
                <input name="authorWebsite" inputmode="url" class="w-full rounded-2xl border border-zinc-200 bg-white px-4 py-3 text-zinc-900 outline-none ring-0 placeholder:text-zinc-400 focus:border-accent dark:border-slate-700 dark:bg-slate-950 dark:text-white" placeholder="https://example.com" />
              </label>
            </div>
            <label class="mt-4 block text-sm text-zinc-600 dark:text-zinc-300">
              <span class="mb-2 block font-medium text-zinc-900 dark:text-white">评论内容</span>
              <textarea name="body" rows="6" maxlength="4000" required class="w-full rounded-[1.5rem] border border-zinc-200 bg-white px-4 py-3 text-zinc-900 outline-none ring-0 placeholder:text-zinc-400 focus:border-accent dark:border-slate-700 dark:bg-slate-950 dark:text-white" placeholder="欢迎分享你的问题、反馈或补充。"></textarea>
            </label>
            <div class="mt-4 space-y-4">
              ${turnstileBlock}
              ${feedback}
              <div class="flex flex-wrap items-center justify-between gap-3">
                <p class="text-xs leading-6 text-zinc-500 dark:text-zinc-400">请勿提交广告、灌水或与文章无关的内容。回复最多支持 ${config.maxDepth + 1} 层；视频外链需单独一行，HTML 会按文本显示。</p>
                <button type="submit" class="rounded-full bg-zinc-950 px-5 py-3 text-sm font-medium text-white hover:bg-accent dark:bg-white dark:text-zinc-950 dark:hover:bg-accent dark:hover:text-zinc-950" ${state.submitting || !config.isTurnstileConfigured ? 'disabled' : ''}>${state.submitting ? '提交中…' : '提交评论'}</button>
              </div>
            </div>
          </form>
        `;
      };

      const renderLoading = () => {
        root.innerHTML = `
          ${renderForm()}
          <div class="rounded-[1.75rem] border border-dashed border-zinc-200/80 px-5 py-10 text-center text-sm text-zinc-500 dark:border-slate-800 dark:text-zinc-400">评论加载中…</div>
        `;
      };

      const render = () => {
        if (state.loading) {
          renderLoading();
          return;
        }

        const listHtml = state.comments.length
          ? state.comments.map(renderComment).join('')
          : '<div class="rounded-[1.75rem] border border-dashed border-zinc-200/80 px-5 py-10 text-center text-sm leading-7 text-zinc-500 dark:border-slate-800 dark:text-zinc-400">还没有公开评论。欢迎成为第一位留言的人。</div>';

        root.innerHTML = `
          ${renderForm()}
          <div class="space-y-4">
            <div class="flex items-center justify-between gap-3">
              <h3 class="text-lg font-semibold text-zinc-950 dark:text-white">已公开的评论</h3>
              <p class="text-xs uppercase tracking-[0.18em] text-zinc-500 dark:text-zinc-400">${state.comments.length} 条顶层讨论</p>
            </div>
            <div class="space-y-4">${listHtml}</div>
          </div>
        `;

        const turnstileTarget = document.getElementById('comments-turnstile');
        if (config.isTurnstileConfigured && turnstileTarget && window.turnstile) {
          if (state.turnstileWidgetId) {
            state.turnstileWidgetId = window.turnstile.render(turnstileTarget, {
              sitekey: config.turnstileSiteKey,
              theme: document.documentElement.classList.contains('dark') ? 'dark' : 'light'
            });
          } else {
            state.turnstileWidgetId = window.turnstile.render(turnstileTarget, {
              sitekey: config.turnstileSiteKey,
              theme: document.documentElement.classList.contains('dark') ? 'dark' : 'light'
            });
          }
        }
      };

      const fetchComments = async () => {
        state.loading = true;
        state.error = '';
        render();
        try {
          const response = await fetch(`${config.apiBaseUrl.replace(/\/$/, '')}/api/posts/${encodeURIComponent(config.slug)}/comments`, {
            credentials: 'include',
            headers: visitorHeaders()
          });
          const data = await response.json();
          if (!response.ok || !data.ok) {
            throw new Error(data.error || '评论加载失败。');
          }
          state.comments = Array.isArray(data.comments) ? data.comments : [];
        } catch (error) {
          state.error = error instanceof Error ? error.message : '评论加载失败。';
        } finally {
          state.loading = false;
          render();
        }
      };

      const toggleLike = async (commentId, currentlyLiked) => {
        state.error = '';
        try {
          const response = await fetch(`${config.apiBaseUrl.replace(/\/$/, '')}/api/comments/${encodeURIComponent(commentId)}/like`, {
            method: 'POST',
            credentials: 'include',
            headers: {
              'content-type': 'application/json',
              ...visitorHeaders()
            },
            body: JSON.stringify({ liked: !currentlyLiked })
          });
          const data = await response.json();
          if (!response.ok || !data.ok) {
            throw new Error(data.error || '点赞操作失败。');
          }
          state.comments = updateCommentNode(state.comments, commentId, {
            likeCount: data.likeCount,
            likedByViewer: data.likedByViewer,
            bloggerLiked: data.bloggerLiked
          });
        } catch (error) {
          state.error = error instanceof Error ? error.message : '点赞操作失败。';
        } finally {
          render();
        }
      };

      const submitComment = async (form) => {
        const formData = new FormData(form);
        const token = getTurnstileToken();

        state.submitting = true;
        state.error = '';
        state.success = '';
        render();
        const endpoint = state.replyParentId
          ? `${config.apiBaseUrl.replace(/\/$/, '')}/api/comments/${encodeURIComponent(state.replyParentId)}/replies`
          : `${config.apiBaseUrl.replace(/\/$/, '')}/api/posts/${encodeURIComponent(config.slug)}/comments`;
        const payload = {
          authorName: formData.get('authorName'),
          authorWebsite: formData.get('authorWebsite'),
          body: formData.get('body'),
          postTitle: config.postTitle,
          postUrl: config.postUrl,
          turnstileToken: token,
          slug: config.slug
        };

        try {
          const response = await fetch(endpoint, {
            method: 'POST',
            credentials: 'include',
            headers: {
              'content-type': 'application/json'
            },
            body: JSON.stringify(payload)
          });
          const data = await response.json();
          if (!response.ok || !data.ok) {
            throw new Error(data.error || '评论提交失败。');
          }

          form.reset();
          state.replyParentId = null;
          state.replyTargetName = '';
          state.success = '评论已提交，等待审核通过后会出现在这里。';
          resetTurnstile();
          await fetchComments();
          state.success = '评论已提交，等待审核通过后会出现在这里。';
        } catch (error) {
          state.error = error instanceof Error ? error.message : '评论提交失败。';
          resetTurnstile();
          render();
        } finally {
          state.submitting = false;
          render();
        }
      };

      root.addEventListener('click', (event) => {
        const target = event.target instanceof HTMLElement ? event.target.closest('[data-action]') : null;
        if (!(target instanceof HTMLElement)) return;
        const action = target.dataset.action;
        if (action === 'reply') {
          state.replyParentId = target.dataset.commentId || null;
          state.replyTargetName = target.dataset.authorName || '';
          state.error = '';
          state.success = '';
          render();
          document.getElementById('comment-form')?.scrollIntoView({ behavior: 'smooth', block: 'start' });
          root.querySelector('input[name="authorName"]')?.focus();
        }
        if (action === 'like') {
          toggleLike(target.dataset.commentId || '', target.dataset.liked === 'true');
        }
        if (action === 'cancel-reply') {
          state.replyParentId = null;
          state.replyTargetName = '';
          render();
        }
      });

      root.addEventListener('submit', (event) => {
        if (!(event.target instanceof HTMLFormElement) || event.target.id !== 'comment-form') return;
        event.preventDefault();
        submitComment(event.target);
      });

      const ensureTurnstile = () => {
        if (!config.isTurnstileConfigured) {
          render();
          return;
        }
        if (window.turnstile) {
          render();
          return;
        }
        const existing = document.querySelector('script[data-comments-turnstile]');
        if (existing) return;
        const script = document.createElement('script');
        script.src = 'https://challenges.cloudflare.com/turnstile/v0/api.js?render=explicit';
        script.async = true;
        script.defer = true;
        script.dataset.commentsTurnstile = 'true';
        script.onload = () => {
          render();
        };
        document.head.appendChild(script);
      };

      document.addEventListener('theme-changed', () => {
        if (!config.isTurnstileConfigured || !window.turnstile || !state.turnstileWidgetId) return;
        state.turnstileWidgetId = null;
        render();
      });

      renderLoading();
      ensureTurnstile();
      fetchComments();
    }
  </script>
)}
