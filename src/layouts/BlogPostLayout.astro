---
import BaseLayout from './BaseLayout.astro';
import TableOfContents from '../components/TableOfContents.astro';
import TagList from '../components/TagList.astro';
import CommentsSection from '../components/CommentsSection.astro';
import { formatDate } from '../lib/dates';
import { withAsset, withBase } from '../lib/site';
import type { BlogEntry } from '../lib/blog';
import type { TocItem } from '../lib/toc';

interface Props {
  post: BlogEntry;
  tocItems: TocItem[];
  previous?: BlogEntry;
  next?: BlogEntry;
}

type PostAttachment = BlogEntry['data']['attachments'][number];
type RenderedAttachment = Omit<PostAttachment, 'type'> & { href: string; type: string };

const { post, tocItems, previous, next } = Astro.props;
const heroImage = post.data.heroImage ? withAsset(post.data.heroImage) : undefined;
const attachments: RenderedAttachment[] = post.data.attachments.map((attachment: PostAttachment) => ({
  ...attachment,
  href: withAsset(attachment.file),
  type: (attachment.type || 'other').toUpperCase()
}));
---
<BaseLayout
  title={post.data.title}
  description={post.data.description}
  pathname={`/posts/${post.slug}/`}
  image={post.data.heroImage}
  type="article"
  publishedTime={post.data.pubDate.toISOString()}
  updatedTime={post.data.updatedDate?.toISOString()}
  tags={post.data.tags}
>
  <div class="grid gap-10 lg:grid-cols-[minmax(0,1fr)_280px]">
    <article>
      <header class="rounded-[2rem] border border-white/60 bg-white/76 p-6 shadow-glow backdrop-blur dark:border-slate-800/80 dark:bg-slate-950/76 md:p-10">
        <div class="flex flex-wrap items-center gap-3 text-xs uppercase tracking-[0.2em] text-zinc-500 dark:text-zinc-400">
          <time datetime={post.data.pubDate.toISOString()}>{formatDate(post.data.pubDate)}</time>
          {post.data.updatedDate && <span>更新于 {formatDate(post.data.updatedDate)}</span>}
        </div>
        <h1 class="mt-5 max-w-4xl font-serif text-4xl leading-tight tracking-[-0.04em] text-zinc-950 dark:text-white md:text-6xl">{post.data.title}</h1>
        <p class="mt-5 max-w-reading text-lg leading-8 text-zinc-600 dark:text-zinc-300">{post.data.description}</p>
        <div class="mt-6">
          <TagList tags={post.data.tags.map((tag: string) => ({ tag }))} />
        </div>
        {heroImage && (
          <div class="mt-8 overflow-hidden rounded-[1.75rem] border border-zinc-200/80 dark:border-slate-800">
            <img src={heroImage} alt={post.data.title} decoding="async" class="aspect-[16/8] w-full object-cover" />
          </div>
        )}
      </header>

      <div class="mt-10 rounded-[2rem] border border-zinc-200/80 bg-white/72 p-6 shadow-panel dark:border-slate-800 dark:bg-slate-950/72 md:p-10">
        <div class="prose prose-zinc max-w-none dark:prose-invert prose-headings:scroll-mt-28 prose-a:text-accent">
          <slot />
        </div>
      </div>

      {attachments.length > 0 && (
        <section class="post-attachments mt-10" aria-labelledby="post-attachments-heading">
          <div class="flex flex-wrap items-end justify-between gap-3">
            <div>
              <p class="font-mono text-[11px] uppercase tracking-[0.28em] text-zinc-500 dark:text-zinc-400">Attachments</p>
              <h2 id="post-attachments-heading" class="mt-2 text-2xl font-semibold tracking-[-0.03em] text-zinc-950 dark:text-white">附件</h2>
            </div>
            <span class="text-sm text-zinc-500 dark:text-zinc-400">{attachments.length} 个文件</span>
          </div>
          <div class="mt-5 grid gap-4 md:grid-cols-2">
            {attachments.map((attachment) => (
              <a href={attachment.href} class="attachment-card" target="_blank" rel="noreferrer">
                <span class="attachment-type">{attachment.type}</span>
                <span class="attachment-title">{attachment.title}</span>
                {attachment.description && <span class="attachment-description">{attachment.description}</span>}
                <span class="attachment-action">打开或下载</span>
              </a>
            ))}
          </div>
        </section>
      )}

      <div class="mt-10 grid gap-4 md:grid-cols-2">
        {previous ? (
          <a href={withBase(`/posts/${previous.slug}/`)} class="rounded-[1.75rem] border border-zinc-200/80 bg-white/72 p-5 shadow-panel hover:border-accent dark:border-slate-800 dark:bg-slate-950/72">
            <p class="font-mono text-[11px] uppercase tracking-[0.24em] text-zinc-500 dark:text-zinc-400">上一篇</p>
            <p class="mt-3 text-lg font-medium text-zinc-900 dark:text-white">{previous.data.title}</p>
          </a>
        ) : <div />}
        {next ? (
          <a href={withBase(`/posts/${next.slug}/`)} class="rounded-[1.75rem] border border-zinc-200/80 bg-white/72 p-5 text-right shadow-panel hover:border-accent dark:border-slate-800 dark:bg-slate-950/72">
            <p class="font-mono text-[11px] uppercase tracking-[0.24em] text-zinc-500 dark:text-zinc-400">下一篇</p>
            <p class="mt-3 text-lg font-medium text-zinc-900 dark:text-white">{next.data.title}</p>
          </a>
        ) : <div />}
      </div>

      <CommentsSection slug={post.slug} title={post.data.title} />
    </article>

    <div class="lg:sticky lg:top-28 lg:h-fit">
      <TableOfContents items={tocItems} />
    </div>
  </div>
</BaseLayout>
